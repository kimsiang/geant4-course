# Highland test: a pencil beam of mu- through 1, 2, 5 and 10 cm of steel, at 1, 3 and 10 GeV.
# Twelve runs of 20 000 muons, one ROOT file each: slab_<t>cm_<E>GeV.root
/control/verbose 1
/run/verbose 0
/scat/det/shape slab
/scat/det/material G4_Fe
/run/initialize
/control/foreach slab_thickness.mac t "1 2 5 10"
